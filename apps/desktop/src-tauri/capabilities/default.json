{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOWNLOAD/**" }]
    },
    "fs:allow-download-write",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "monday-server",
          "sidecar": true
        },
        { "name": "claude-version", "cmd": "claude", "args": ["--version"] },
        { "name": "claude-auth", "cmd": "claude", "args": ["auth", "status"] },
        {
          "name": "claude",
          "cmd": "claude",
          "args": [
            "-p",
            "--verbose",
            "--input-format",
            "stream-json",
            "--output-format",
            "stream-json",
            "--include-partial-messages",
            "--strict-mcp-config",
            "--mcp-config",
            { "validator": "\\{\"mcpServers\":\\{\"monday\":\\{[^\\n]*\\}\\}\\}" },
            "--setting-sources",
            { "validator": "" },
            "--permission-mode",
            { "validator": "dontAsk|acceptEdits" },
            "--allowedTools",
            { "validator": "mcp__monday(,[A-Za-z]+)*" },
            "--tools",
            { "validator": "|default" },
            "--system-prompt",
            { "validator": "[\\s\\S]*" },
            "--session-id",
            { "validator": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" },
            "--no-session-persistence"
          ]
        },
        { "name": "codex-version", "cmd": "codex", "args": ["--version"] },
        { "name": "codex-login", "cmd": "codex", "args": ["login", "status"] },
        { "name": "codex", "cmd": "codex", "args": ["app-server"] },
        { "name": "opencode-version", "cmd": "opencode", "args": ["--version"] },
        { "name": "opencode-auth", "cmd": "opencode", "args": ["auth", "list"] },
        { "name": "opencode", "cmd": "opencode", "args": ["acp"] }
      ]
    }
  ]
}
