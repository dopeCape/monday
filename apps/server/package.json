{
  "name": "@monday/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch entry/bun.ts",
    "start": "bun entry/bun.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "compile": "bun build --compile --compile-exec-argv=--smol entry/bun.ts --outfile dist/monday-server",
    "check:vercel": "bun scripts/check-entry.ts vercel",
    "check:netlify": "bun scripts/check-entry.ts netlify netlify-tick"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monday/shared": "workspace:*",
    "@monday/ui": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "domhandler": "^6",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "18.4.0-beta.17",
    "hono": "^4.7.0",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.0.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "postal-mime": "^3.0.0",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/sanitize-html": "^2.16.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  }
}
