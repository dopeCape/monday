  },
  "dependencies": {
    "@monday/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "18.4.0-beta.17",
    "hono": "^4.7.0",
    "postgres": "^3.4.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10"
  }
}
