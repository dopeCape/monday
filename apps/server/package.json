{
  "name": "@monday/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch entry/bun.ts",
    "start": "bun entry/bun.ts",
    "typecheck": "tsc --noEmit -p .",
