{
  "name": "monday",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @monday/desktop dev",
    "tauri": "bun run stage && bun run --filter @monday/desktop tauri",
    "server": "bun run --filter @monday/server dev",
    "design": "bun design/serve.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "stage": "bun scripts/stage-sidecar.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.3"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ]
}
